# Copie este arquivo para .env exclusivamente no ambiente de deploy.
# Nunca versionar .env, backups, chaves ou credenciais reais.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://pedidos.seu-dominio.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_KEY=GERAR_UMA_CHAVE_ALEATORIA_LONGA_FORA_DO_REPOSITORIO

# Banco MySQL provisionado pelo EasyPanel. Criar usuário exclusivo da aplicação.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=brasa_burger
DB_USERNAME=brasa_app
DB_PASSWORD=DEFINIR_NO_EASYPANEL

# Sessões PHP
SESSION_NAME=brasa_session
SESSION_SECURE=true
SESSION_SAMESITE=Lax
SESSION_IDLE_MINUTES=30

# Armazenamento persistente, montado como volume no container da aplicação.
STORAGE_PATH=/var/www/storage
UPLOAD_MAX_MB=5

# Rate limiting e auditoria
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_ORDER_PER_HOUR=12
LOG_LEVEL=warning

# Backups. Não incluir senha real neste arquivo.
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=DEFINIR_FORA_DO_REPOSITORIO
